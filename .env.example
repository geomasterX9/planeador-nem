# Copia este archivo como .env y rellena con tus valores reales
# NUNCA subas el archivo .env a git

# Google OAuth (Google Cloud Console → Credenciales → ID de cliente OAuth)
VITE_GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# Supabase (tu proyecto → Settings → API)
VITE_SUPABASE_URL=https://tu_proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key

# Gemini API Key — NO va en el frontend
# Configúrala en Supabase: supabase secrets set GEMINI_API_KEY=tu_clave
